<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.alan.jupiter.fx.controller.CounselorController"
      spacing="0"
      styleClass="root">

    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="toolbar">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="刷新" onAction="#onRefresh" styleClass="btn-ghost"/>
        <Button text="导出账户" onAction="#onExportAccounts" styleClass="btn-ghost"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS">
        <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
        <TableView fx:id="counselorTable" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="暂无查宿者账号，可通过「文件 → 导入工作人员名单」批量导入"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colName" text="姓名" prefWidth="100" minWidth="70"/>
                <TableColumn fx:id="colStudentNo" text="学号" prefWidth="120" minWidth="90"/>
                <TableColumn fx:id="colClassName" text="班级" prefWidth="110" minWidth="70"/>
                <TableColumn fx:id="colGender" text="性别" prefWidth="58" minWidth="50"/>
                <TableColumn fx:id="colPhone" text="手机号" prefWidth="120" minWidth="90"/>
                <TableColumn fx:id="colDepartment" text="部门" prefWidth="100" minWidth="70"/>
                <TableColumn fx:id="colActive" text="状态" prefWidth="64" minWidth="50"/>
                <TableColumn fx:id="colActions" text="操作" prefWidth="160" minWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="net.alan.jupiter.fx.controller.ReportController"
            styleClass="root">

    <VBox spacing="18">
        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

        <HBox spacing="12">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="BUILDINGS" styleClass="stat-label"/>
                <Label fx:id="totalBuildingLabel" text="--" styleClass="stat-value"/>
                <Label text="楼栋总数" styleClass="caption"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="ROOMS" styleClass="stat-label"/>
                <Label fx:id="totalRoomLabel" text="--" styleClass="stat-value"/>
                <Label text="房间总数" styleClass="caption"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="STUDENTS" styleClass="stat-label"/>
                <Label fx:id="totalStudentLabel" text="--" styleClass="stat-value"/>
                <Label text="学生总数" styleClass="caption"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="RECORDS" styleClass="stat-label"/>
                <Label fx:id="checkRecordCountLabel" text="--" styleClass="stat-value"/>
                <Label text="查寝记录" styleClass="caption"/>
            </VBox>
        </HBox>

        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" styleClass="toolbar">
                <Label text="BUILDING SUMMARY" styleClass="section-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="房间数 / 学生数" styleClass="caption"/>
            </HBox>
            <VBox fx:id="buildingStatBox" spacing="0"/>
        </VBox>
    </VBox>
</ScrollPane>

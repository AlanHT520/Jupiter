<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.alan.jupiter.fx.controller.CheckRecordController"
      spacing="0"
      styleClass="root">

    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="toolbar">
        <Label text="RECORDS" styleClass="section-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="刷新" onAction="#onRefresh" styleClass="btn-ghost"/>
        <Button text="一键清除" onAction="#onClearAll" styleClass="btn-danger"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS">
        <padding><Insets top="14" right="18" bottom="10" left="18"/></padding>
        <TableView fx:id="recordTable" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="暂无查寝记录"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colRoom" text="房间号" prefWidth="100" minWidth="70"/>
                <TableColumn fx:id="colStudentNo" text="学号" prefWidth="120" minWidth="80"/>
                <TableColumn fx:id="colStudentName" text="姓名" prefWidth="100" minWidth="70"/>
                <TableColumn fx:id="colStatus" text="状态" prefWidth="110" minWidth="70"/>
                <TableColumn fx:id="colStatusSource" text="来源" prefWidth="100" minWidth="70"/>
                <TableColumn fx:id="colSubmittedBy" text="提交人" prefWidth="130" minWidth="80"/>
            </columns>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT" styleClass="pagination-bar">
        <Label fx:id="pageInfoLabel" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="上一页" fx:id="prevBtn" onAction="#onPrevPage" styleClass="btn-ghost"/>
        <Button text="下一页" fx:id="nextBtn" onAction="#onNextPage" styleClass="btn-ghost"/>
    </HBox>
</VBox>

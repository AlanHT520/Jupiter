<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="net.alan.jupiter.fx.controller.MainController"
            styleClass="root-layout">

    <top>
        <HBox styleClass="top-bar">
            <HBox styleClass="brand-mark" alignment="CENTER_LEFT">
                <Label text="寝安" styleClass="brand-name"/>
                <Label text="宿舍查寝系统 v0.9.1" styleClass="brand-ver"/>
            </HBox>

            <Label fx:id="pathLabel" text="寝安 / 仪表盘" styleClass="path-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <MenuBar styleClass="app-menu-bar">
                <Menu text="文件">
                    <MenuItem text="导入宿舍数据" onAction="#onImportRoster"/>
                    <MenuItem text="导入工作人员名单" onAction="#onImportCounselors"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="导出查寝报表" onAction="#onExportReport"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="退出" onAction="#onExit"/>
                </Menu>
                <Menu text="帮助">
                    <MenuItem text="关于寝安" onAction="#onAbout"/>
                </Menu>
            </MenuBar>

            <HBox styleClass="shell-right">
                <Label fx:id="connDot" text="●" styleClass="conn-dot" visible="false" managed="false"/>
                <Label fx:id="connLabel" text="" styleClass="conn-text" visible="false" managed="false"/>
                <Label fx:id="clockLabel" text="--:--:--" styleClass="clock-label"/>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="brand-block">
                <Label text="寝安" styleClass="brand-title"/>
                <Label text="宿舍查寝系统" styleClass="brand-sub"/>
            </VBox>

            <Label text="工作台" styleClass="nav-section-label"/>
            <fx:define>
                <ToggleGroup fx:id="navGroup"/>
            </fx:define>
            <ToggleButton text="01  仪表盘" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/dashboard.fxml" onAction="#onNav"/>
            <ToggleButton text="02  任务管理" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/task.fxml" onAction="#onNav"/>
            <ToggleButton text="03  查寝记录" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/check-record.fxml" onAction="#onNav"/>

            <Label text="数据" styleClass="nav-section-label"/>
            <ToggleButton text="04  花名册" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/roster.fxml" onAction="#onNav"/>
            <ToggleButton text="05  工作人员" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/counselor.fxml" onAction="#onNav"/>
            <ToggleButton text="06  楼栋结构" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/building.fxml" onAction="#onNav"/>
            <ToggleButton text="07  导入导出" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/import-export.fxml" onAction="#onNav"/>
            <ToggleButton text="08  注册审核" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/registration-management.fxml" onAction="#onNav"/>

            <Label text="预分配" styleClass="nav-section-label"/>
            <ToggleButton text="12  任务预分配" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/task-template.fxml" onAction="#onNav"/>

            <Label text="系统" styleClass="nav-section-label"/>
            <ToggleButton text="09  日志查看" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/log-viewer.fxml" onAction="#onNav"/>
            <ToggleButton text="10  报表" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/report.fxml" onAction="#onNav"/>
            <ToggleButton text="11  系统配置" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/system-config.fxml" onAction="#onNav"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-footer">
                <Label fx:id="sideUserName" text="桌面端" styleClass="sidebar-footer-title"/>
                <Label text="v1.0.0 · JavaFX 21" styleClass="sidebar-footer-sub"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox styleClass="header-bar">
                    <VBox spacing="1">
                        <Label fx:id="pageTitleLabel" text="仪表盘" styleClass="header-title"/>
                        <Label fx:id="pageSubtitleLabel" text="实时统计与事件流" styleClass="header-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox styleClass="user-chip">
                        <Label fx:id="avatarLabel" text="A" styleClass="avatar-circle"/>
                        <Label fx:id="userLabel" text="桌面端" styleClass="user-chip-name"/>
                    </HBox>
                </HBox>
            </top>

            <center>
                <StackPane fx:id="contentPane" styleClass="app-content"/>
            </center>
        </BorderPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar-shell">
            <HBox styleClass="status-left">
                <Label fx:id="dbLabel" text="" styleClass="status-item" visible="false" managed="false"/>
                <Label text="│" styleClass="status-sep"/>
                <Label fx:id="tcpStatusLabel" text="" styleClass="status-item-strong" visible="false" managed="false"/>
                <Label text="│" styleClass="status-sep"/>
                <Label fx:id="profileLabel" text="" styleClass="status-item" visible="false" managed="false"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox styleClass="status-right">
                <Label fx:id="statusUserLabel" text="用户 -" styleClass="status-item-strong"/>
                <Label text="│" styleClass="status-sep"/>
                <Label fx:id="roleLabel" text="角色 -" styleClass="status-item"/>
                <Label text="│" styleClass="status-sep"/>
                <Label fx:id="versionLabel" text="v0.9.1" styleClass="status-item"/>
            </HBox>
        </HBox>
    </bottom>
</BorderPane>

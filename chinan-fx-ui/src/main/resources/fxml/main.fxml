<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="net.alan.jupiter.fx.controller.MainController"
            styleClass="root-layout">

    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="brand-block">
                <Label text="Chinan" styleClass="brand-title"/>
                <Label text="JAVA EDITION · 寝室管理" styleClass="brand-sub"/>
            </VBox>

            <Label text="工作台" styleClass="nav-section-label"/>
            <fx:define>
                <ToggleGroup fx:id="navGroup"/>
            </fx:define>
            <ToggleButton text="首页概览" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/dashboard.fxml" onAction="#onNav"/>
            <ToggleButton text="学生名册" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/roster.fxml" onAction="#onNav"/>
            <ToggleButton text="查寝任务" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/task.fxml" onAction="#onNav"/>
            <ToggleButton text="查寝记录" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/check-record.fxml" onAction="#onNav"/>
            <ToggleButton text="数据报表" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/report.fxml" onAction="#onNav"/>

            <Label text="基础数据" styleClass="nav-section-label"/>
            <ToggleButton text="楼栋总览" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/building.fxml" onAction="#onNav"/>
            <ToggleButton text="查宿者管理" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/counselor.fxml" onAction="#onNav"/>
            <ToggleButton text="注册管理" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/registration-management.fxml" onAction="#onNav"/>

            <Label text="系统" styleClass="nav-section-label"/>
            <ToggleButton text="系统日志" styleClass="nav-button" maxWidth="Infinity"
                          toggleGroup="$navGroup" userData="/fxml/log-viewer.fxml" onAction="#onNav"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-footer">
                <Label fx:id="sideUserName" text="桌面端" styleClass="sidebar-footer-title"/>
                <Label text="v-0.8.9 · JavaFX 21" styleClass="sidebar-footer-sub"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox styleClass="header-bar">
                    <VBox spacing="2">
                        <Label fx:id="pageTitleLabel" text="首页概览" styleClass="header-title"/>
                        <Label fx:id="pageSubtitleLabel" text="当前数据概况与近期查寝任务" styleClass="header-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <MenuBar styleClass="app-menu-bar">
                        <Menu text="文件">
                            <MenuItem text="导入宿舍数据" onAction="#onImportRoster"/>
                            <MenuItem text="导入工作人员名单" onAction="#onImportCounselors"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="导出查寝报表" onAction="#onExportReport"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="退出" onAction="#onExit"/>
                        </Menu>
                        <Menu text="帮助">
                            <MenuItem text="关于 Chinan" onAction="#onAbout"/>
                        </Menu>
                    </MenuBar>

                    <HBox styleClass="user-chip">
                        <Label fx:id="avatarLabel" text="A" styleClass="avatar-circle"/>
                        <Label fx:id="userLabel" text="桌面端" styleClass="user-chip-name"/>
                    </HBox>
                </HBox>
            </top>

            <center>
                <StackPane fx:id="contentPane" styleClass="app-content"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>

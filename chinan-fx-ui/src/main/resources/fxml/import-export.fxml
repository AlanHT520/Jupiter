<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.alan.jupiter.fx.controller.ImportExportController"
      spacing="12"
      styleClass="root">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="数据导入导出" styleClass="page-title"/>

    <HBox spacing="12">
        <Button fx:id="importBtn" text="导入宿舍数据" onAction="#onImport" styleClass="btn-primary"/>
        <Button fx:id="exportBtn" text="导出报表" onAction="#onExport" styleClass="btn-ghost"/>
    </HBox>

    <HBox spacing="8" styleClass="status-bar">
        <Label text="状态:"/>
        <Label fx:id="statusLabel" text="就绪"/>
    </HBox>

    <TextArea fx:id="logArea" VBox.vgrow="ALWAYS"
              editable="false" wrapText="true"
              promptText="操作日志"/>
</VBox>
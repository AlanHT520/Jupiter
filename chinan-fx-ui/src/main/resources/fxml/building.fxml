<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="net.alan.jupiter.fx.controller.BuildingController"
            styleClass="root">

    <VBox spacing="0">
        <HBox alignment="CENTER_LEFT" styleClass="toolbar">
            <Label text="BUILDINGS" styleClass="section-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="数据来自名册导入" styleClass="caption"/>
        </HBox>

        <VBox>
            <padding><Insets top="16" right="18" bottom="18" left="18"/></padding>
            <FlowPane fx:id="buildingCards" hgap="12" vgap="12"/>
        </VBox>
    </VBox>
</ScrollPane>

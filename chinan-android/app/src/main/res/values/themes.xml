<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      铺满全屏（edge-to-edge）的公共部分：
      - 窗口底色跟随 App 背景，避免浅色主题下露出深色边框；
      - 系统栏透明，内容延伸到状态栏 / 导航栏后面。

      高版本专属属性（刘海、系统栏对比度遮罩、导航栏图标明暗）分别放在
      values-v27 / values-v29 里，避免 minSdk 26 触发 lint 的 NewApi 错误。
    -->
    <style name="Theme.ChinanKE.Base" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_window_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/app_light_system_bars</item>
    </style>

    <style name="Theme.ChinanKE" parent="Theme.ChinanKE.Base" />
</resources>

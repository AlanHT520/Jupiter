<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.alan.jupiter.fx.controller.TaskController"
      spacing="0"
      styleClass="root">

    <HBox alignment="CENTER_LEFT" styleClass="toolbar">
        <Label text="查寝任务管理" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="一键清除已完成" onAction="#onClearCompleted" styleClass="btn-danger"/>
        <Button text="创建任务" onAction="#onCreateTask" styleClass="btn-primary"/>
        <Button text="刷新" onAction="#onRefresh" styleClass="btn-ghost"/>
    </HBox>

    <TableView fx:id="taskTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTaskNo" text="任务编号" prefWidth="120" minWidth="80"/>
            <TableColumn fx:id="colTitle" text="任务标题" prefWidth="180" minWidth="100"/>
            <TableColumn fx:id="colBuilding" text="楼栋" prefWidth="80" minWidth="60"/>
            <TableColumn fx:id="colFloor" text="楼层" prefWidth="60" minWidth="50"/>
            <TableColumn fx:id="colRooms" text="房间" prefWidth="100" minWidth="70"/>
            <TableColumn fx:id="colChecker" text="查宿者" prefWidth="90" minWidth="70"/>
            <TableColumn fx:id="colStatus" text="状态" prefWidth="70" minWidth="55"/>
            <TableColumn fx:id="colTotal" text="总房" prefWidth="55" minWidth="45"/>
            <TableColumn fx:id="colChecked" text="已查" prefWidth="55" minWidth="45"/>
            <TableColumn fx:id="colActions" text="操作" prefWidth="200" minWidth="160"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" styleClass="pagination-bar">
        <Label fx:id="pageInfoLabel"/>
        <Button text="上一页" fx:id="prevBtn" onAction="#onPrevPage" styleClass="btn-ghost"/>
        <Button text="下一页" fx:id="nextBtn" onAction="#onNextPage" styleClass="btn-ghost"/>
    </HBox>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="net.alan.jupiter.fx.controller.MainController"
            styleClass="root-layout">

    <top>
        <HBox styleClass="menu-bar-container">
            <MenuBar styleClass="app-menu-bar" HBox.hgrow="ALWAYS">
                <Menu text="文件(F)">
                    <MenuItem text="导入宿舍数据" onAction="#onImportRoster"/>
                    <MenuItem text="导入工作人员名单" onAction="#onImportCounselors"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="导出查寝报表" onAction="#onExportReport"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="退出" onAction="#onExit"/>
                </Menu>
                <Menu text="视图(V)">
                    <MenuItem text="首页概览" onAction="#onDashboard"/>
                    <MenuItem text="学生名册" onAction="#onRoster"/>
                    <MenuItem text="任务管理" onAction="#onTask"/>
                    <MenuItem text="查寝记录" onAction="#onCheckRecord"/>
                    <MenuItem text="系统日志" onAction="#onLogViewer"/>
                    <MenuItem text="楼栋总览" onAction="#onBuilding"/>
                    <MenuItem text="查宿者管理" onAction="#onCounselor"/>
                </Menu>
                <Menu text="帮助(H)">
                    <MenuItem text="关于..." onAction="#onAbout"/>
                </Menu>
            </MenuBar>
            <Label fx:id="userLabel" styleClass="menu-bar-user"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentPane" styleClass="app-content"/>
    </center>
</BorderPane>
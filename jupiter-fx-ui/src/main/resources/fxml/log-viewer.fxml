<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.alan.jupiter.fx.controller.LogViewerController"
      spacing="0"
      styleClass="root">

    <HBox alignment="CENTER_LEFT" styleClass="toolbar">
        <Label text="系统日志" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="刷新" onAction="#onRefresh" styleClass="btn-ghost"/>
    </HBox>

    <TextArea fx:id="logArea" VBox.vgrow="ALWAYS"
              styleClass="log-viewer"
              editable="false" wrapText="false"
              promptText="暂无日志记录"/>
</VBox>
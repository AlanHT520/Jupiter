<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="net.alan.jupiter.fx.controller.BuildingController"
            styleClass="root">

    <VBox spacing="20">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

        <VBox spacing="4">
            <Label text="楼栋总览" styleClass="page-title"/>
            <Label text="各宿舍楼房间与学生概况"
                   style="-fx-text-fill: #808080; -fx-font-size: 13px;"/>
        </VBox>

        <FlowPane fx:id="buildingCards" hgap="16" vgap="16"/>
    </VBox>
</ScrollPane>
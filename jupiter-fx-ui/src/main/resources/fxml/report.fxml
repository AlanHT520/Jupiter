<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.alan.jupiter.fx.controller.ReportController"
      spacing="0"
      styleClass="root">

    <HBox alignment="CENTER_LEFT" styleClass="toolbar">
        <Label text="数据统计概览" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshBtn" text="刷新" onAction="#onRefresh" styleClass="btn-ghost"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="24">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <HBox spacing="16">
                <VBox styleClass="stat-card" spacing="10" prefWidth="200">
                    <Label text="&#x1F3E2;" style="-fx-font-size: 22px;"/>
                    <Label text="楼栋总数" styleClass="stat-label"/>
                    <Label fx:id="totalBuildingLabel" text="--" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="10" prefWidth="200">
                    <Label text="&#x1F3E0;" style="-fx-font-size: 22px;"/>
                    <Label text="房间总数" styleClass="stat-label"/>
                    <Label fx:id="totalRoomLabel" text="--" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="10" prefWidth="200">
                    <Label text="&#x1F393;" style="-fx-font-size: 22px;"/>
                    <Label text="学生总数" styleClass="stat-label"/>
                    <Label fx:id="totalStudentLabel" text="--" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="10" prefWidth="200">
                    <Label text="&#x1F4DD;" style="-fx-font-size: 22px;"/>
                    <Label text="查寝记录" styleClass="stat-label"/>
                    <Label fx:id="checkRecordCountLabel" text="--" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <Separator/>

            <VBox spacing="12">
                <Label text="各楼栋明细" styleClass="page-subtitle"/>
                <VBox fx:id="buildingStatBox" spacing="6"/>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>